+"""Per-sample gate on the state tokens of pi0.5's discrete state input, opened during the run.
+
+A sample with an open gate is tokenized with the state in the prompt, a sample with a closed gate without it (the prompt
+of a model trained without state input). The model transform emits both tokenizations for every sample under the keys
+below; `GatedDataset` keeps the one the gate selects. `GatedSampler` draws the gates: it wraps a sampler that yields
+`batch_size` indices per step in step order (`MixSampler`) and yields `(index, open)` pairs.
+"""
+
+import dataclasses
+
+import numpy as np
+import torch
+
+TOKENS_WITHOUT_STATE = "tokenized_prompt_without_state"
+MASK_WITHOUT_STATE = "tokenized_prompt_mask_without_state"
+
+
+@dataclasses.dataclass(frozen=True)
+class GateSchedule:
+    """Probability that a sample's gate is open: `start` at step 0, `end` at step `ramp_steps`, linear between, `end` after."""
+
+    start: float
+    end: float
+    ramp_steps: int
+
+    def __post_init__(self) -> None:
+        if not (0.0 <= self.start <= 1.0 and 0.0 <= self.end <= 1.0):
+            raise ValueError(f"open probabilities must lie in [0, 1], got {self.start} and {self.end}")
+        if self.ramp_steps < 1:
+            raise ValueError(f"ramp_steps must be at least 1, got {self.ramp_steps}")
+
+    def open_probability(self, step: int) -> float:
+        return self.start + (self.end - self.start) * min(step, self.ramp_steps) / self.ramp_steps
+
+
+class GatedSampler:
+    """Adds the gate of each sample to the indices of `inner`: `(index, open)`, one gate draw per sample."""
+
+    def __init__(self, inner, batch_size: int, schedule: GateSchedule, skip_steps: int, seed: int):
+        self._inner, self._batch_size, self._schedule, self._skip_steps, self._seed = (
+            inner,
+            batch_size,
+            schedule,
+            skip_steps,
+            seed,
+        )
+
+    def __len__(self) -> int:
+        return len(self._inner)
+
+    def __iter__(self):
+        rng = np.random.default_rng(self._seed)
+        # A resumed run continues the draws of a fresh run: the draws of the steps already trained are consumed.
+        for _ in range(self._skip_steps):
+            rng.random(self._batch_size)
+        step = self._skip_steps
+        draws: np.ndarray | None = None
+        for position, index in enumerate(self._inner):
+            slot = position % self._batch_size
+            if slot == 0:
+                draws = rng.random(self._batch_size)
+                probability = self._schedule.open_probability(step)
+                step += 1
+            yield index, bool(draws[slot] < probability)
+
+
+class GatedDataset(torch.utils.data.Dataset):
+    """Dataset whose items are addressed by `(index, open)`: the sample of `index` with the tokenization the gate selects."""
+
+    def __init__(self, dataset):
+        self._dataset = dataset
+
+    def __len__(self) -> int:
+        return len(self._dataset)
+
+    def __getitem__(self, key: tuple[int, bool]) -> dict:
+        index, gate_open = key
+        sample = dict(self._dataset[index])
+        without_state = sample.pop(TOKENS_WITHOUT_STATE)
+        mask_without_state = sample.pop(MASK_WITHOUT_STATE)
+        if not gate_open:
+            sample["tokenized_prompt"] = without_state
+            sample["tokenized_prompt_mask"] = mask_without_state
+        return sample
