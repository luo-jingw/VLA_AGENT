diff -urN a/src/openpi/training/mixture.py b/src/openpi/training/mixture.py
--- a/src/openpi/training/mixture.py	1969-12-31 16:00:00.000000000 -0800
+++ b/src/openpi/training/mixture.py	2026-11-01 14:49:11.170793607 -0800
@@ -0,0 +1,76 @@
+"""Index sequence for training on two datasets whose proportions change during the run.
+
+`MixSampler` draws the rows of every batch from the concatenation [primary rows, secondary rows]: each row comes from
+the secondary dataset with the fraction `MixSchedule.fraction(step)` of its step and from the primary dataset
+otherwise. Each dataset is traversed in shuffled passes, so no row repeats before the dataset has been used up.
+"""
+
+import dataclasses
+
+import numpy as np
+
+
+@dataclasses.dataclass(frozen=True)
+class MixSchedule:
+    """Fraction of secondary rows per batch: `start` at the first step, `end` at step `steps - 1`, linear between."""
+
+    start: float
+    end: float
+    steps: int
+    # Steps already trained when a run resumes: the sampler yields the continuation of the sequence of a fresh run.
+    skip_steps: int = 0
+
+    def __post_init__(self) -> None:
+        if not (0.0 <= self.start <= 1.0 and 0.0 <= self.end <= 1.0):
+            raise ValueError(f"fractions must lie in [0, 1], got {self.start} and {self.end}")
+        if not 0 <= self.skip_steps < self.steps:
+            raise ValueError(f"skip_steps {self.skip_steps} must lie in [0, steps {self.steps})")
+
+    def fraction(self, step: int) -> float:
+        if self.steps == 1:
+            return self.start
+        return self.start + (self.end - self.start) * min(step, self.steps - 1) / (self.steps - 1)
+
+
+class _ShuffledPasses:
+    """Row indices of one dataset: a fresh random permutation per pass."""
+
+    def __init__(self, size: int, offset: int, rng: np.random.Generator):
+        self._size, self._offset, self._rng = size, offset, rng
+        self._order = rng.permutation(size)
+        self._next = 0
+
+    def take(self, count: int) -> list[int]:
+        taken = []
+        for _ in range(count):
+            if self._next == self._size:
+                self._order = self._rng.permutation(self._size)
+                self._next = 0
+            taken.append(self._offset + int(self._order[self._next]))
+            self._next += 1
+        return taken
+
+
+class MixSampler:
+    """Sampler over a torch ConcatDataset([primary, secondary]): `batch_size` indices per step, in step order."""
+
+    def __init__(self, n_primary: int, n_secondary: int, batch_size: int, schedule: MixSchedule, seed: int):
+        if n_primary < 1 or n_secondary < 1:
+            raise ValueError("both datasets need at least one row")
+        self._sizes = (n_primary, n_secondary)
+        self._batch_size = batch_size
+        self._schedule = schedule
+        self._seed = seed
+
+    def __len__(self) -> int:
+        return (self._schedule.steps - self._schedule.skip_steps) * self._batch_size
+
+    def __iter__(self):
+        rng = np.random.default_rng(self._seed)
+        primary = _ShuffledPasses(self._sizes[0], 0, rng)
+        secondary = _ShuffledPasses(self._sizes[1], self._sizes[0], rng)
+        for step in range(self._schedule.steps):
+            n_secondary = int(np.sum(rng.random(self._batch_size) < self._schedule.fraction(step)))
+            batch = primary.take(self._batch_size - n_secondary) + secondary.take(n_secondary)
+            if step >= self._schedule.skip_steps:
+                yield from batch
